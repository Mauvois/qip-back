# Copier ce fichier vers .env.prod (ignoré par Git) et renseigner les valeurs réelles.
ALLOWED_HOSTS=qip.taan.ovh
CSRF_TRUSTED_ORIGINS=https://qip.taan.ovh
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SIGNING_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL existant : DB_HOST doit être joignable depuis qip_backend_net.
DB_HOST=replace-with-db-host
DB_PORT=5432
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_NAME=replace-with-db-name

# Stockage GCP utilisé par l'API en production.
GS_BUCKET_NAME=replace-with-bucket
GS_PROJECT_ID=replace-with-project
GOOGLE_CREDENTIALS_B64=replace-with-single-line-base64-service-account-json

# Facultatif tant que la connexion OAuth Zotero n'est pas activée.
ZOTERO_OAUTH_CLIENT_KEY=
ZOTERO_OAUTH_CLIENT_SECRET=
ZOTERO_TOKEN_ENCRYPTION_KEY=
